# Liveblocks (realtime canvas sync) — https://liveblocks.io/dashboard/apikeys
NEXT_PUBLIC_LIVEBLOCKS_PUBLIC_KEY=

# YouCam / Perfect Corp API — https://yce.makeupar.com/api-console/en/api-keys/
# Server-only. Never expose this to the client.
YOUCAM_API_KEY=

# Database (Supabase Postgres) — project ref: qwrdtoibxbukggdsczgy (modelier, ap-south-1)
# Dashboard: https://supabase.com/dashboard/project/qwrdtoibxbukggdsczgy/settings/database
# Use Transaction pooler URI for Next.js; replace [YOUR-PASSWORD].
# DATABASE_URL=postgresql://postgres.qwrdtoibxbukggdsczgy:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=
# Used by Prisma only for schema push/migrate. The literal "direct" host
# (db.<ref>.supabase.co:5432) didn't resolve from this network — fell back to
# the session-pooler variant (same pooler host, port 5432, no pgbouncer flag),
# which supports the prepared statements db push needs.
# DIRECT_URL=postgresql://postgres.qwrdtoibxbukggdsczgy:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
DIRECT_URL=

# Auth.js (v5) — generate with `npx auth secret`
AUTH_SECRET=

# Style Assistant (conversational AI panel, lib/assistant/*) — pick the backend
# with ASSISTANT_PROVIDER, then set only that provider's own key(s) below.
# Switching providers is just changing this one value, no code changes.
ASSISTANT_PROVIDER=anthropic
# anthropic (default)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
# gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# k2think — K2 Think (MBZUAI Institute of Foundation Models), served over an
# OpenAI-compatible endpoint. Point K2THINK_BASE_URL at whichever host serves
# it (self-hosted vLLM, or a provider that hosts it) — there's no public
# MBZUAI-run hosted API to default this to.
K2THINK_BASE_URL=
K2THINK_API_KEY=
K2THINK_MODEL=LLM360/K2-Think-V2

# Adobe Firefly (Magic Expand / Magic Eraser, lib/firefly/client.ts) — not
# live yet, see design.md's "Upcoming" note. Fill in once you have API access:
# https://developer.adobe.com/firefly-services/docs/guides/
FIREFLY_CLIENT_ID=
FIREFLY_CLIENT_SECRET=

# Supabase Storage (uploaded product photos, re-hosted results, seeded reference-model photos)
# Dashboard: https://supabase.com/dashboard/project/qwrdtoibxbukggdsczgy/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://qwrdtoibxbukggdsczgy.supabase.co
# Server-only. Never expose this to the client.
SUPABASE_SERVICE_ROLE=
