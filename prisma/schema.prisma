generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id             String          @id @default(cuid())
  email          String          @unique
  passwordHash   String
  name           String?
  createdAt      DateTime        @default(now())
  brandKits      BrandKit[]
  projects       Project[]
  generations    Generation[]
  jewelryDesigns JewelryDesign[]
}

model BrandKit {
  id          String    @id @default(cuid())
  userId      String
  name        String
  logoUrl     String?
  colors      Json // { primary, secondary, accent, background, text }
  fontDisplay String?
  fontBody    String?
  isDefault   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id])
  projects    Project[]
}

model Template {
  id           String   @id @default(cuid())
  name         String
  format       String // "instagram_post" | "instagram_story" | "product_listing"
  category     String? // "apparel" | "beauty" | "general"
  thumbnailUrl String
  canvasJson   Json // serialized fabric.js object array; placeholder objects tagged isPlaceholder: true
  isSystem     Boolean  @default(true)
  createdAt    DateTime @default(now())
  projects     Project[]
}

model Project {
  id               String       @id @default(cuid())
  userId           String
  brandKitId       String?
  templateId       String?
  name             String
  width            Int          @default(500)
  height           Int          @default(500)
  format           String? // one of lib/formats.ts's ids, or "custom"
  thumbnailUrl     String? // captured client-side (canvas.toDataURL) a few seconds after each edit, see PUT /api/projects/[id]/thumbnail
  canvasJson       Json         @default("[]") // vestigial since Liveblocks storage is now the live source of truth for an open project
  liveblocksRoomId String       @unique // `project-room-${id}` — every project gets its own room now
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  user             User         @relation(fields: [userId], references: [id])
  brandKit         BrandKit?    @relation(fields: [brandKitId], references: [id])
  template         Template?    @relation(fields: [templateId], references: [id])
  generations      Generation[]
}

// A curated, fully-synthetic (text-to-image generated, never a real person) reference
// model used as the "src" image for apparel/beauty VTO. Seeded once via
// scripts/seed-reference-models.ts, not created by end users.
model ReferenceModel {
  id                String   @id @default(cuid())
  label             String // "Model A — deep warm, curvy"
  bodyType          String // "slim" | "athletic" | "curvy" | "plus"
  skinToneHex       String // detected via AI Skin Tone Analysis on the generated image, not hand-assigned
  undertone         String // "warm" | "cool" | "neutral" — derived from skinToneHex
  youcamFileId      String? // File API id for this model's photo, reused across generations to avoid re-upload
  imageUrl          String // public/reference-models/{slug}.png
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  variants          GenerationVariant[]
  poses             ReferenceModelPose[]
}

// Close-up pose photos for the same synthetic identity as a ReferenceModel, needed for
// jewelry VTO categories the full-body shot can't frame tightly enough (ring/bracelet/
// watch need a hand/wrist close-up; necklace/earring can reuse the full-body shot).
// Seeded once via scripts/seed-reference-model-poses.ts, reusing the parent's already
// -detected skin descriptor — NOT a guaranteed identity match across generations, see
// that script's header comment.
model ReferenceModelPose {
  id               String   @id @default(cuid())
  referenceModelId String
  pose             String // "hand" | "wrist" | "neck_ears"
  youcamFileId     String?
  imageUrl         String
  createdAt        DateTime @default(now())
  referenceModel   ReferenceModel @relation(fields: [referenceModelId], references: [id])

  @@unique([referenceModelId, pose])
}

model Generation {
  id               String   @id @default(cuid())
  userId           String
  projectId        String?
  flow             String // "apparel_vto" | "makeup_vto" | "image_to_video" | "jewelry_vto"
  garmentCategory  String? // "upper_body" | "lower_body" | "full_body" | "auto" (apparel only)
  jewelryCategory  String? // "ring" | "necklace" | "earring" | "bracelet" | "watch" (jewelry_vto only)
  sourceImageUrl   String? // uploaded product photo, once Storage is wired up
  garmentColorHex  String? // dominant garment color (apparel) OR dominant metal-tone hex (jewelry), for lib/colorHarmony.ts
  isDiversityBatch Boolean  @default(false)
  status           String // "pending" | "processing" | "success" | "partial" | "error"
  errorMessage     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User      @relation(fields: [userId], references: [id])
  project          Project?  @relation(fields: [projectId], references: [id])
  variants         GenerationVariant[]
}

model GenerationVariant {
  id                String   @id @default(cuid())
  generationId      String
  // Optional — the image_to_video flow animates an arbitrary source image
  // (a canvas selection or a fresh upload), not a curated ReferenceModel.
  referenceModelId  String?
  youcamTaskId      String?
  youcamFeature     String // "cloth-v3" | "makeup-vto" | "image-to-video" | "ring-vto" | "necklace-vto" | "earring-vto" | "bracelet-vto" | "watch-vto"
  status            String // "pending" | "processing" | "success" | "error"
  resultImageUrl    String? // holds a video URL for the image_to_video flow
  errorMessage      String?
  colorHarmonyScore Int?
  colorHarmonyNote  String?
  isBestMatch       Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  generation        Generation      @relation(fields: [generationId], references: [id])
  referenceModel    ReferenceModel? @relation(fields: [referenceModelId], references: [id])
}

// A jewelry piece designed in the standalone Jewelry Studio (see app/jewelry/*) — either
// assembled from JewelryPartOption swatches ("configurator") or drawn freehand
// ("sketch"). Deliberately independent of Project/Template — Jewelry Studio is a
// separate feature from the marketing canvas, not a canvas project type.
model JewelryDesign {
  id               String   @id @default(cuid())
  userId           String
  name             String
  category         String // "ring" | "necklace" | "earring" | "bracelet" | "watch"
  method           String // "configurator" | "sketch"
  designJson       Json // configurator: {partSelections: {partType: optionId}}; sketch: fabric.js canvasJson array
  renderedImageUrl String? // composited product-shot PNG, re-hosted to Supabase — used as the VTO "ref" photo and as an importable asset in the marketing canvas
  thumbnailUrl     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id])
}

// One selectable swatch for one part of one jewelry category in the configurator (e.g.
// category "ring", partType "band", label "Thin gold band"). imageUrl is supplied
// separately (not generated by seeding) — see scripts/seed-jewelry-parts.ts. Starts
// empty; the configurator UI must render a clean empty state until this is populated.
model JewelryPartOption {
  id        String   @id @default(cuid())
  category  String // "ring" | "necklace" | "earring" | "bracelet" | "watch"
  partType  String // "band" | "setting" | "stone" | "metal_finish" | ...
  label     String
  imageUrl  String
  slot      Json // {left, top, width, height} — fixed position/size within the category's composite
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}
